# Copie este arquivo para .env e troque os valores. O .env NAO vai para o git.
# Os valores abaixo sao FALSOS, so de exemplo.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-gerada-por-voce

# True so no seu computador; em producao fica False.
DEBUG=True

# Enderecos aceitos pelo servidor, separados por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco local (SQLite, arquivo db.sqlite3 na raiz do projeto).
DATABASE_URL=sqlite:///db.sqlite3
# Exemplo de PostgreSQL (usado no CI e em producao):
# DATABASE_URL=postgres://usuario:senha@localhost:5432/galao_helpdesk

# So em producao (deixe comentado no seu computador):
# Origens https aceitas no CSRF, separadas por virgula.
# CSRF_TRUSTED_ORIGINS=https://meu-app.up.railway.app
# True liga redirecionamento para https, cookies seguros e HSTS.
# HTTPS_SEGURO=False
